{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/affenschlabi00/siryapsalot/schema/ir.schema.json",
  "title": "Sir Yaps-a-Lot IR",
  "description": "Machine-level intermediate representation: real x86-64 instructions with symbolic names for jump targets, Win32 imports, named data, and virtual registers. The deterministic backend resolves names to bytes. This schema is the frozen contract between model and backend (Plan section 4).",
  "type": "object",
  "required": ["metadata", "code"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "entry"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Program name (used for output filename)." },
        "subsystem": { "enum": ["console", "gui"], "default": "console" },
        "entry": { "type": "string", "minLength": 1, "description": "Label of the entry-point procedure." },
        "description": { "type": "string", "description": "Optional human note about what the program does." }
      }
    },
    "imports": {
      "type": "array",
      "description": "Win32 APIs the program imports from system DLLs. The backend builds the import directory / IAT.",
      "items": {
        "type": "object",
        "required": ["dll", "function"],
        "additionalProperties": false,
        "properties": {
          "dll": { "type": "string", "pattern": "(?i)^[\\w.-]+\\.dll$" },
          "function": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data": {
      "type": "array",
      "description": "Initialized data. 'bytes'/'utf8' are read-only (.rdata); integer types and 'zeros' are writable (.data).",
      "items": {
        "type": "object",
        "required": ["label", "type"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "type": { "enum": ["bytes", "utf8", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "zeros"] },
          "value": {
            "description": "String for bytes/utf8 (Python-style \\n, \\t, \\0, \\xNN escapes honored); integer for numeric types; ignored for 'zeros'.",
            "type": ["string", "integer", "array"]
          },
          "size": { "type": "integer", "minimum": 1, "description": "Byte count for 'zeros' (reserved writable buffer)." },
          "comment": { "type": "string" }
        }
      }
    },
    "code": {
      "type": "array",
      "minItems": 1,
      "description": "One or more procedures. Each is a label plus a list of instructions.",
      "items": {
        "type": "object",
        "required": ["label", "instructions"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "comment": { "type": "string" },
          "instructions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["op"],
                  "additionalProperties": false,
                  "properties": {
                    "op": { "type": "string", "minLength": 1, "description": "x86-64 mnemonic (lowercase), or the pseudo-op 'label:'." },
                    "args": {
                      "type": "array",
                      "items": { "type": ["string", "integer"] },
                      "description": "Operands. May reference: real regs (rax,ecx,...), virtual regs (%vN), immediates, memory ([rsp+32]), code labels (bare name), data:LABEL, import:DLL!FUNC."
                    },
                    "comment": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "description": "Local label inside a procedure (branch target).",
                  "required": ["label"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                    "comment": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
