{
  "metadata": {
    "name": "christmas_tree",
    "subsystem": "console",
    "entry": "main",
    "description": "Prints a centered ASCII christmas tree (6 rows of stars). Built from the request 'make me a christmas tree'."
  },
  "imports": [
    { "dll": "kernel32.dll", "function": "GetStdHandle" },
    { "dll": "kernel32.dll", "function": "WriteFile" },
    { "dll": "kernel32.dll", "function": "ExitProcess" }
  ],
  "data": [
    { "label": "hStdout", "type": "u64", "value": 0 },
    { "label": "line", "type": "zeros", "size": 64 },
    { "label": "written", "type": "u32", "value": 0 }
  ],
  "code": [
    {
      "label": "main",
      "instructions": [
        { "op": "mov",  "args": ["ecx", "-11"] },
        { "op": "call", "args": ["import:kernel32.dll!GetStdHandle"] },
        { "op": "mov",  "args": ["qword ptr [data:hStdout]", "rax"] },
        { "op": "mov",  "args": ["%v0", "0"], "comment": "row = 0" },
        { "label": "row_loop" },
        { "op": "cmp",  "args": ["%v0", "6"] },
        { "op": "jge",  "args": ["done"] },
        { "op": "lea",  "args": ["r10", "data:line"], "comment": "p = line" },
        { "op": "mov",  "args": ["rcx", "5"] },
        { "op": "sub",  "args": ["rcx", "%v0"], "comment": "spaces = 5 - row" },
        { "label": "sp_loop" },
        { "op": "test", "args": ["rcx", "rcx"] },
        { "op": "jle",  "args": ["sp_done"] },
        { "op": "mov",  "args": ["byte ptr [r10]", "32"], "comment": "' '" },
        { "op": "inc",  "args": ["r10"] },
        { "op": "dec",  "args": ["rcx"] },
        { "op": "jmp",  "args": ["sp_loop"] },
        { "label": "sp_done" },
        { "op": "mov",  "args": ["rcx", "%v0"] },
        { "op": "add",  "args": ["rcx", "%v0"], "comment": "2*row" },
        { "op": "inc",  "args": ["rcx"], "comment": "2*row + 1 stars" },
        { "label": "st_loop" },
        { "op": "test", "args": ["rcx", "rcx"] },
        { "op": "jle",  "args": ["st_done"] },
        { "op": "mov",  "args": ["byte ptr [r10]", "42"], "comment": "'*'" },
        { "op": "inc",  "args": ["r10"] },
        { "op": "dec",  "args": ["rcx"] },
        { "op": "jmp",  "args": ["st_loop"] },
        { "label": "st_done" },
        { "op": "mov",  "args": ["byte ptr [r10]", "10"], "comment": "newline" },
        { "op": "inc",  "args": ["r10"] },
        { "op": "mov",  "args": ["rcx", "qword ptr [data:hStdout]"] },
        { "op": "lea",  "args": ["rdx", "data:line"] },
        { "op": "lea",  "args": ["rax", "data:line"] },
        { "op": "mov",  "args": ["r8", "r10"] },
        { "op": "sub",  "args": ["r8", "rax"], "comment": "length = p - line" },
        { "op": "lea",  "args": ["r9", "data:written"] },
        { "op": "mov",  "args": ["qword ptr [rsp+32]", "0"] },
        { "op": "call", "args": ["import:kernel32.dll!WriteFile"] },
        { "op": "inc",  "args": ["%v0"] },
        { "op": "jmp",  "args": ["row_loop"] },
        { "label": "done" },
        { "op": "mov",  "args": ["ecx", "0"] },
        { "op": "call", "args": ["import:kernel32.dll!ExitProcess"] }
      ]
    }
  ]
}
