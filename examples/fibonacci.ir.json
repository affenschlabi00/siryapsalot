{
  "metadata": {
    "name": "fibonacci",
    "subsystem": "console",
    "entry": "main",
    "description": "Prints the Fibonacci numbers below 100, one per line. Generated from the intent 'print the fibonacci numbers below 100'."
  },
  "imports": [
    { "dll": "kernel32.dll", "function": "GetStdHandle" },
    { "dll": "kernel32.dll", "function": "WriteFile" },
    { "dll": "kernel32.dll", "function": "ExitProcess" }
  ],
  "data": [
    { "label": "hStdout", "type": "u64", "value": 0 },
    { "label": "numbuf", "type": "zeros", "size": 32 },
    { "label": "written", "type": "u32", "value": 0 }
  ],
  "code": [
    {
      "label": "main",
      "instructions": [
        { "op": "mov",  "args": ["ecx", "-11"] },
        { "op": "call", "args": ["import:kernel32.dll!GetStdHandle"] },
        { "op": "mov",  "args": ["qword ptr [data:hStdout]", "rax"], "comment": "save stdout handle globally" },
        { "op": "mov",  "args": ["%v0", "0"], "comment": "a" },
        { "op": "mov",  "args": ["%v1", "1"], "comment": "b" },
        { "label": "fib_loop" },
        { "op": "cmp",  "args": ["%v0", "100"] },
        { "op": "jge",  "args": ["fib_done"] },
        { "op": "mov",  "args": ["rcx", "%v0"] },
        { "op": "call", "args": ["print_uint"] },
        { "op": "mov",  "args": ["rax", "%v0"] },
        { "op": "add",  "args": ["rax", "%v1"], "comment": "t = a + b" },
        { "op": "mov",  "args": ["%v0", "%v1"], "comment": "a = b" },
        { "op": "mov",  "args": ["%v1", "rax"], "comment": "b = t" },
        { "op": "jmp",  "args": ["fib_loop"] },
        { "label": "fib_done" },
        { "op": "mov",  "args": ["ecx", "0"] },
        { "op": "call", "args": ["import:kernel32.dll!ExitProcess"] }
      ]
    },
    {
      "label": "print_uint",
      "comment": "print the unsigned integer in rcx followed by a newline",
      "instructions": [
        { "op": "mov",  "args": ["rax", "rcx"] },
        { "op": "lea",  "args": ["r10", "data:numbuf"] },
        { "op": "mov",  "args": ["r11", "r10"] },
        { "op": "add",  "args": ["r11", "31"] },
        { "op": "mov",  "args": ["byte ptr [r11]", "10"], "comment": "trailing newline" },
        { "op": "mov",  "args": ["r9", "10"] },
        { "op": "test", "args": ["rax", "rax"] },
        { "op": "jnz",  "args": ["pu_loop"] },
        { "op": "dec",  "args": ["r11"] },
        { "op": "mov",  "args": ["byte ptr [r11]", "48"], "comment": "value 0 -> '0'" },
        { "op": "jmp",  "args": ["pu_done"] },
        { "label": "pu_loop" },
        { "op": "test", "args": ["rax", "rax"] },
        { "op": "jz",   "args": ["pu_done"] },
        { "op": "xor",  "args": ["rdx", "rdx"] },
        { "op": "div",  "args": ["r9"] },
        { "op": "add",  "args": ["dl", "48"] },
        { "op": "dec",  "args": ["r11"] },
        { "op": "mov",  "args": ["byte ptr [r11]", "dl"] },
        { "op": "jmp",  "args": ["pu_loop"] },
        { "label": "pu_done" },
        { "op": "lea",  "args": ["rax", "data:numbuf"] },
        { "op": "add",  "args": ["rax", "32"] },
        { "op": "sub",  "args": ["rax", "r11"], "comment": "length" },
        { "op": "mov",  "args": ["rcx", "qword ptr [data:hStdout]"] },
        { "op": "mov",  "args": ["rdx", "r11"] },
        { "op": "mov",  "args": ["r8", "rax"] },
        { "op": "lea",  "args": ["r9", "data:written"] },
        { "op": "mov",  "args": ["qword ptr [rsp+32]", "0"] },
        { "op": "call", "args": ["import:kernel32.dll!WriteFile"] },
        { "op": "ret" }
      ]
    }
  ]
}
